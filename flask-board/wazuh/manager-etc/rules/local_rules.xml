<!-- Flask Board / Wazuh / Suricata Security Rules -->


<!-- ================================================== -->
<!-- 1. Hydra 로그인 무차별 대입 탐지 -->
<!-- ================================================== -->

<group name="webapp,local,">

  <!-- 로그인 실패 -->
  <rule id="100210" level="5">
    <decoded_as>webapp-login</decoded_as>
    <match>login_failed</match>
    <description>연습 웹앱 로그인 실패</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- 동일 IP에서 120초 동안 로그인 실패 6회 -->
  <rule id="100211" level="10" frequency="6" timeframe="120">
    <if_matched_sid>100210</if_matched_sid>
    <same_srcip />
    <description>Hydra 로그인 무차별 대입 의심 - 동일 IP 다수 실패</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

</group>


<!-- ================================================== -->
<!-- 2. Flask 게시판 파일 위변조 탐지 -->
<!-- ================================================== -->

<!-- 경로 구분자는 '.', 확장자 점은 '[.]' 사용 -->

<group name="flask_board,syscheck,local,">

  <!-- 게시판 템플릿 파일 변경 -->
  <rule id="100221" level="8">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">(?i)_7_board_test.templates.</field>
    <description>게시판 화면 템플릿 파일 변경 - 위변조 의심</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

  <!-- 실행형 파일 생성 및 변조 -->
  <rule id="100220" level="12">
    <if_sid>100221</if_sid>
    <field name="file" type="pcre2">(?i)[.](php|jsp|jspx|asp|aspx|py|sh|exe|ps1)$</field>
    <description>게시판 웹 디렉터리에 실행형 파일 생성/변조 - 웹셸 의심</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
  </rule>

  <!-- 실행형 파일 삭제 -->
  <rule id="100222" level="10">
    <if_sid>100220</if_sid>
    <decoded_as>syscheck_deleted</decoded_as>
    <description>게시판 웹 디렉터리의 실행형 파일 삭제 - 흔적 제거 의심(확인 필요)</description>
    <mitre>
      <id>T1070.004</id>
    </mitre>
  </rule>

</group>


<!-- ================================================== -->
<!-- 3. Nikto / Gobuster HTTP 404 폭주 탐지 -->
<!-- ================================================== -->

<!-- HTTP 404 탐지 -->
<group name="flask_board,webscan,local,">

  <!-- HTTP 404 단일 발생 -->
  <rule id="100230" level="5">
    <decoded_as>webapp-404</decoded_as>
    <match>http_404</match>
    <description>Flask 게시판 HTTP 404 발생</description>
    <group>web_scan,http_404,</group>
  </rule>

  <!-- 동일 IP에서 30초 동안 404 30회 초과 -->
  <rule id="100231" level="10" frequency="31" timeframe="30" ignore="60">
    <if_matched_sid>100230</if_matched_sid>
    <same_srcip />
    <description>Flask 게시판 HTTP 404 폭주 - 웹 스캐너 공격 의심</description>
    <mitre>
      <id>T1595</id>
    </mitre>
    <group>web_scan,http_404_flood,</group>
  </rule>

</group>

<!-- ================================================== -->
<!-- 4. Suricata IDS / Nmap / SQLmap 탐지 -->
<!-- ================================================== -->

<group name="suricata,ids,local,">
  <rule id="100240" level="3">
    <decoded_as>suricata-alert</decoded_as>
    <description>Suricata IDS Alert 발생</description>
    <group>ids_alert,</group>
  </rule>
  <rule id="100241" level="10">
    <if_sid>100240</if_sid>
    <field name="signature" type="pcre2">(?i)(portscan|nmap|port scan)</field>
    <description>Suricata Nmap 포트 스캔 탐지</description>
    <mitre><id>T1046</id></mitre>
    <group>ids_alert,nmap,port_scan,</group>
  </rule>
  <rule id="100242" level="12">
    <if_sid>100240</if_sid>
    <field name="signature" type="pcre2">(?i)(sqlmap|sql injection)</field>
    <description>Suricata SQL Injection 탐지</description>
    <mitre><id>T1190</id></mitre>
    <group>ids_alert,sqlmap,sql_injection,</group>
  </rule>
  <rule id="100243" level="12" frequency="6" timeframe="30" ignore="60">
    <if_matched_sid>100240</if_matched_sid>
    <same_source_ip />
    <description>Suricata IDS 경보 폭주 - 동일 IP 5회 초과</description>
    <group>ids_alert,attack_frequency,</group>
  </rule>
</group>