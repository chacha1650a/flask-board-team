# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 커밋되지 않는다.

# 기존 MySQL 접속 정보
DATABASE_URL=mysql+pymysql://<계정>:<비밀번호>@localhost:3306/my_new_board_db
MYSQL_ROOT_PASSWORD=<MySQL root 비밀번호>

# 로그인 토큰 서명 키
JWT_SECRET_KEY=<32자 이상 랜덤 문자열>

# n8n과 공유하는 보안 이벤트 API 키
SECURITY_API_KEY=<32자 이상 랜덤 문자열>
# 계정 잠금·IP 차단·인시던트 API 키. 비우면 SECURITY_API_KEY를 함께 사용한다.
ADMIN_API_KEY=<32자 이상 랜덤 문자열>
# 자동 권한 감사에서 관리자 유지가 허용된 아이디(쉼표 구분)
ADMIN_ALLOWLIST=<관리자아이디1>,<관리자아이디2>

# 게시판 로그인 실패 이벤트를 받는 Graylog GELF UDP 입력
GELF_HOST=localhost
GELF_PORT=12201
# 권한 회수 봇이 조회할 게시판 주소
BOARD_URL=http://localhost:5000

# n8n 운영 Webhook 주소와 제출 식별자
N8N_WEBHOOK_URL=http://localhost:5678/webhook/<본인 경로>
STUDENT_NAME=<본인 식별자>

# n8n 메신저 목적지. 실제 값은 .env에만 두고 Git/문서에 넣지 않는다.
DISCORD_WEBHOOK_NAME=Spidey Bot
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<새 Incoming Webhook>
TELEGRAM_BOT_TOKEN=<BotFather에서 발급한 새 봇 토큰>
TELEGRAM_CHAT_ID=<메시지를 받을 개인 또는 그룹 chat_id>

# deny 이벤트를 게시판 공지로도 만들려면 1
AUTO_POST_ON_DENY=0

# 공공데이터포털 일반 인증키(Decoding)
PUBLIC_API_KEY=<공공데이터포털 서비스키>
# 부산 테마여행 API 주소 (/api/public/posts, /public-posts 화면이 사용)
PUBLIC_API_URL=http://apis.data.go.kr/6260000/RecommendedService/getRecommendedKr

# 기존 LLM 실습용 키
LLM_API_KEY=<LLM API 키>
